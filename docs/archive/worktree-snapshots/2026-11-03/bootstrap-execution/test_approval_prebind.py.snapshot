"""Synthetic coverage for approval prebinding and output recovery."""

from __future__ import annotations

import io
import hashlib
import json
import pathlib
import subprocess
import tempfile
import unittest
from concurrent.futures import ThreadPoolExecutor
from contextlib import redirect_stdout
from unittest import mock

from agentctl.approval import (
    SYNTHETIC_FIXTURE_KEY,
    ApprovalManager,
    ApprovalRejected,
    build_approval,
    seal_approval,
)
from agentctl.commands import approve as approve_command
from agentctl.commands.approve import _issue_record
from agentctl.config import Config
from agentctl.local_authentication import LocalAuthenticationResult
from agentctl.store import EventStore


def _repo_root() -> pathlib.Path:
    return pathlib.Path(
        subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip()
    )


class ApprovalPrebindTests(unittest.TestCase):
    root = _repo_root()
    approval_id = "11111111-1111-4111-8111-111111111111"
    policy = {"tiers": {"phase_authorization": "interactive_tty_with_key_unlock"}}

    def _record(self, *, nonce: str, approval_id: str | None = None) -> dict:
        return seal_approval(
            build_approval(
                principal="synthetic-owner",
                machine_identity="synthetic-machine",
                action="phase_authorization",
                target_type="phase-gate",
                target_id="SYNTHETIC-GATE",
                target_hash="a" * 64,
                scope="synthetic exact scope",
                reason="synthetic test only",
                approval_id=approval_id or self.approval_id,
                nonce=nonce,
            ),
            SYNTHETIC_FIXTURE_KEY,
        )

    def test_requested_uuid_is_canonical_and_bound_before_authentication(self) -> None:
        """Removing the requested ID binding would leave authentication unbound."""
        calls: list[dict[str, str]] = []

        class Adapter:
            def authenticate(self, **kwargs: str) -> object:
                calls.append(kwargs)
                return LocalAuthenticationResult.AUTHENTICATED

        record = _issue_record(
            key=SYNTHETIC_FIXTURE_KEY,
            principal="synthetic-owner",
            machine_identity="synthetic-machine",
            action="schema_commitment",
            target_type="schema",
            target_id="SYNTHETIC",
            target_hash="a" * 64,
            scope="synthetic scope",
            reason="synthetic test only",
            policy={"tiers": {"schema_commitment": ["local_authentication"]}},
            authentication_adapter=Adapter(),
            approval_id=self.approval_id,
        )
        self.assertEqual(record["approval_id"], self.approval_id)
        self.assertEqual(calls[0]["approval_id"], self.approval_id)

    def test_invalid_id_preflight_fails_before_authentication_or_store_open(self) -> None:
        """Removing ID validation would allow malformed authority into issuance."""
        config = Config(
            repo_root=self.root,
            runtime_dir=self.root / ".synthetic-runtime",
            seal_key_path=self.root / ".synthetic-key",
        )
        argv = [
            "phase_authorization", "--target-type", "phase-gate", "--target-id", "GATE",
            "--target-hash", "a" * 64, "--reason", "synthetic", "--approval-id",
            "NOT-A-UUID", "--preflight",
        ]
        with (
            mock.patch.object(approve_command, "load_config", return_value=config),
            mock.patch.object(approve_command, "EventStore") as event_store,
            mock.patch.object(approve_command, "_issue_record") as issue,
        ):
            with self.assertRaises(ApprovalRejected) as raised:
                approve_command.run(argv)
        self.assertEqual(raised.exception.code, "approval_input_invalid")
        event_store.assert_not_called()
        issue.assert_not_called()

    def test_distinct_payloads_with_one_id_reach_transaction_and_collision(self) -> None:
        """Using only an ID in the outer key could cache a different payload as success."""
        with tempfile.TemporaryDirectory() as directory:
            store = EventStore(pathlib.Path(directory) / "agentctl.sqlite3", repository_root=self.root)
            manager = ApprovalManager(store, key=SYNTHETIC_FIXTURE_KEY, policy=self.policy)
            first = self._record(nonce="1" * 32)
            second = self._record(nonce="2" * 32)

            def register(record: dict) -> str:
                try:
                    manager.register(record, path="synthetic.json")
                    return "registered"
                except ApprovalRejected as exc:
                    return exc.code

            with ThreadPoolExecutor(max_workers=2) as pool:
                outcomes = list(pool.map(register, (first, second)))
            self.assertCountEqual(outcomes, ["registered", "approval_id_collision"])
            persisted = store.rows(
                "SELECT payload_json FROM artifacts WHERE artifact_id = ?", (self.approval_id,)
            )
            self.assertEqual(len(persisted), 1)
            self.assertIn(persisted[0]["payload_json"], {
                json.dumps(first, sort_keys=True, separators=(",", ":")),
                json.dumps(second, sort_keys=True, separators=(",", ":")),
            })
            winner = first if persisted[0]["payload_json"].find('"nonce":"111') >= 0 else second
            before_replay = persisted[0]["payload_json"]
            self.assertEqual(manager.register(winner, path="synthetic.json")["state"], "registered")
            self.assertEqual(store.event_count(), 1)
            self.assertEqual(
                store.rows("SELECT payload_json FROM artifacts WHERE artifact_id = ?", (self.approval_id,))[0]["payload_json"],
                before_replay,
            )
            restarted = ApprovalManager(
                EventStore(store.database, repository_root=self.root),
                key=SYNTHETIC_FIXTURE_KEY,
                policy=self.policy,
            )
            self.assertEqual(restarted.register(winner, path="synthetic.json")["state"], "registered")
            self.assertEqual(store.event_count(), 1)

    def test_recover_output_copies_only_verified_registered_record(self) -> None:
        """Skipping registered-record verification could export untrusted authority."""
        with tempfile.TemporaryDirectory() as directory:
            temporary = pathlib.Path(directory)
            store = EventStore(temporary / "agentctl.sqlite3", repository_root=self.root)
            manager = ApprovalManager(store, key=SYNTHETIC_FIXTURE_KEY, policy=self.policy)
            record = self._record(nonce="3" * 32)
            manager.register(record, path="synthetic.json")
            config = Config(
                repo_root=temporary,
                runtime_dir=temporary / "runtime",
                seal_key_path=temporary / "synthetic.key",
            )
            (temporary / "agent-system/policies").mkdir(parents=True)
            (temporary / "agent-system/policies/approval-policy.json").write_text(
                (self.root / "agent-system/policies/approval-policy.json").read_text(),
                encoding="utf-8",
            )
            (temporary / "agent-system/policies/approval-principals.json").write_text(
                (self.root / "agent-system/policies/approval-principals.json").read_text(),
                encoding="utf-8",
            )
            output = temporary / "recovered.json"
            argv = [
                "phase_authorization", "--target-type", "phase-gate", "--target-id", "SYNTHETIC-GATE",
                "--target-hash", "a" * 64, "--reason", "synthetic", "--scope",
                "synthetic exact scope", "--approval-id", self.approval_id, "--recover-output",
                "--out", str(output),
            ]
            with (
                mock.patch.object(approve_command, "load_config", return_value=config),
                mock.patch.object(approve_command, "EventStore", return_value=store),
                mock.patch.object(approve_command, "ApprovalManager", return_value=manager),
            ):
                with redirect_stdout(io.StringIO()) as captured:
                    self.assertEqual(approve_command.run(argv), 0)
            self.assertEqual(json.loads(output.read_text(encoding="utf-8")), record)
            self.assertIn("recovered_registered_approval", captured.getvalue())
            self.assertEqual(store.event_count(), 1)
            outside = list(argv)
            outside[outside.index("--out") + 1] = str(temporary.parent / "outside.json")
            final_link = temporary / "final-link.json"
            final_link.symlink_to(temporary / "link-target.json")
            final = list(argv)
            final[final.index("--out") + 1] = str(final_link)
            linked_parent = temporary / "linked-parent"
            linked_parent.symlink_to(temporary.parent)
            parent = list(argv)
            parent[parent.index("--out") + 1] = str(linked_parent / "parent-link.json")
            missing = list(argv)
            missing[missing.index("--out") + 1] = str(temporary / "missing" / "child.json")
            for rejected, error_type in ((outside, ApprovalRejected), (final, ApprovalRejected), (parent, ApprovalRejected), (missing, OSError)):
                with self.subTest(output=rejected[-1]), self.assertRaises(error_type):
                    with (
                        mock.patch.object(approve_command, "load_config", return_value=config),
                        mock.patch.object(approve_command, "EventStore", return_value=store),
                        mock.patch.object(approve_command, "ApprovalManager", return_value=manager),
                    ):
                        approve_command.run(rejected)
            self.assertEqual(store.event_count(), 1)
            for option, value, code in (
                ("action", "schema_commitment", "approval_wrong_action"),
                ("--target-type", "other-type", "approval_wrong_target"),
                ("--target-id", "OTHER", "approval_wrong_target"),
                ("--target-hash", "b" * 64, "approval_wrong_target_hash"),
                ("--scope", "other exact scope", "approval_wrong_scope"),
            ):
                changed = list(argv)
                index = 0 if option == "action" else changed.index(option) + 1
                changed[index] = value
                changed[changed.index("--out") + 1] = str(temporary / f"rejected-{code}.json")
                with self.subTest(option=option), self.assertRaises(ApprovalRejected) as raised:
                    with (
                        mock.patch.object(approve_command, "load_config", return_value=config),
                        mock.patch.object(approve_command, "EventStore", return_value=store),
                        mock.patch.object(approve_command, "ApprovalManager", return_value=manager),
                    ):
                        approve_command.run(changed)
                self.assertEqual(raised.exception.code, code)
            manager.consume(
                self.approval_id,
                expected_action="phase_authorization",
                expected_target_type="phase-gate",
                expected_target_id="SYNTHETIC-GATE",
                expected_target_hash="a" * 64,
                expected_scope="synthetic exact scope",
            )
            consumed_argv = list(argv)
            consumed_argv[consumed_argv.index("--out") + 1] = str(temporary / "consumed.json")
            with self.assertRaises(ApprovalRejected) as raised:
                with (
                    mock.patch.object(approve_command, "load_config", return_value=config),
                    mock.patch.object(approve_command, "EventStore", return_value=store),
                    mock.patch.object(approve_command, "ApprovalManager", return_value=manager),
                ):
                    approve_command.run(consumed_argv)
            self.assertEqual(raised.exception.code, "approval_consumed")
            self.assertEqual(store.event_count(), 2)
            with self.assertRaises(ApprovalRejected) as raised:
                manager.consume(
                    self.approval_id,
                    expected_action="phase_authorization",
                    expected_target_hash="a" * 64,
                    expected_scope="synthetic exact scope",
                )
            self.assertEqual(raised.exception.code, "approval_consumed")
            self.assertEqual(store.event_count(), 2)

    def test_output_failure_preserves_registered_authority_for_recovery(self) -> None:
        """Writing output before registration would lose a recoverable approved record."""
        for failure in (FileExistsError("synthetic exists"), PermissionError("synthetic denied"), OSError("synthetic I/O"), RuntimeError("synthetic crash")):
            with self.subTest(failure=type(failure).__name__), tempfile.TemporaryDirectory() as directory:
                temporary = pathlib.Path(directory)
                policy_dir = temporary / "agent-system/policies"
                policy_dir.mkdir(parents=True)
                (policy_dir / "approval-policy.json").write_text(
                    (self.root / "agent-system/policies/approval-policy.json").read_text(), encoding="utf-8"
                )
                principals = json.loads((self.root / "agent-system/policies/approval-principals.json").read_text())
                key = b"s" * 32
                principals["principals"][0]["seal_key_fingerprint"] = hashlib.sha256(key).hexdigest()[:16]
                (policy_dir / "approval-principals.json").write_text(json.dumps(principals), encoding="utf-8")
                store = EventStore(temporary / "agentctl.sqlite3", repository_root=self.root)
                manager = ApprovalManager(store, key=key, policy=self.policy)
                config = Config(repo_root=temporary, runtime_dir=temporary / "runtime", seal_key_path=temporary / "never-read.key")
                approval_id = "22222222-2222-4222-8222-222222222222"
                output = temporary / "failed.json"
                issuance = [
                    "phase_authorization", "--target-type", "phase-gate", "--target-id", "ISSUE-GATE",
                    "--target-hash", "b" * 64, "--scope", "synthetic issue scope", "--reason", "synthetic",
                    "--approval-id", approval_id, "--out", str(output),
                ]
                patches = (
                    mock.patch.object(approve_command, "load_config", return_value=config),
                    mock.patch.object(approve_command, "EventStore", return_value=store),
                    mock.patch.object(approve_command, "ApprovalManager", return_value=manager),
                    mock.patch.object(approve_command, "doctor", return_value={"fingerprint": hashlib.sha256(key).hexdigest()[:16]}),
                    mock.patch.object(approve_command.getpass, "getpass", return_value=key.hex()),
                    mock.patch.object(approve_command.sys, "stdin", mock.Mock(isatty=lambda: True)),
                    mock.patch.object(approve_command, "_write_exclusive_json", side_effect=failure),
                )
                with patches[0], patches[1], patches[2], patches[3], patches[4], patches[5], patches[6], redirect_stdout(io.StringIO()) as captured:
                    if isinstance(failure, OSError):
                        self.assertEqual(approve_command.run(issuance), 1)
                        status = json.loads(captured.getvalue())
                        self.assertEqual(status["status"], "approval_issued_output_failed")
                        self.assertEqual(status["approval_id"], approval_id)
                        self.assertEqual(status["target_hash"], "b" * 64)
                        self.assertIn("--recover-output", status["recovery_command"])
                    else:
                        with self.assertRaises(RuntimeError):
                            approve_command.run(issuance)
                saved = store.rows("SELECT payload_json FROM artifacts WHERE artifact_id = ?", (approval_id,))[0]["payload_json"]
                self.assertEqual(store.event_count(), 1)
                recovery = issuance[:-2] + ["--recover-output", "--out", str(temporary / "recovered.json")]
                with (
                    mock.patch.object(approve_command, "load_config", return_value=config),
                    mock.patch.object(approve_command, "EventStore", return_value=store),
                    mock.patch.object(approve_command, "ApprovalManager", return_value=manager),
                    redirect_stdout(io.StringIO()),
                ):
                    self.assertEqual(approve_command.run(recovery), 0)
                self.assertEqual(store.rows("SELECT payload_json FROM artifacts WHERE artifact_id = ?", (approval_id,))[0]["payload_json"], saved)
                self.assertEqual(store.event_count(), 1)

    def test_recovery_rejects_authentication_method(self) -> None:
        """Accepting --auth-method during recovery would blur issuance and recovery."""
        with self.assertRaises(ApprovalRejected) as raised:
            approve_command.run([
                "phase_authorization", "--target-type", "phase-gate", "--target-id", "GATE",
                "--target-hash", "a" * 64, "--reason", "synthetic", "--approval-id",
                self.approval_id, "--recover-output", "--auth-method",
                "interactive_tty_with_key_unlock",
            ])
        self.assertEqual(raised.exception.code, "approval_input_invalid")

    def test_recovery_rejects_registered_tamper_and_eligibility_failures(self) -> None:
        """Bypassing verified registered bytes could recover invalid single-use authority."""
        with tempfile.TemporaryDirectory() as directory:
            temporary = pathlib.Path(directory)
            (temporary / "agent-system/policies").mkdir(parents=True)
            for name in ("approval-policy.json", "approval-principals.json"):
                (temporary / "agent-system/policies" / name).write_text(
                    (self.root / "agent-system/policies" / name).read_text(), encoding="utf-8"
                )
            principal_policy = {"principals": [{
                "principal_id": "synthetic-owner",
                "authentication_methods": ["interactive_tty_with_key_unlock"],
            }]}
            store = EventStore(temporary / "agentctl.sqlite3", repository_root=self.root)
            manager = ApprovalManager(
                store, key=SYNTHETIC_FIXTURE_KEY, policy=self.policy,
                principal_policy=principal_policy,
            )
            record = self._record(nonce="4" * 32)
            manager.register(record, path="synthetic.json")
            config = Config(repo_root=temporary, runtime_dir=temporary / "runtime", seal_key_path=temporary / "never-read.key")
            argv = [
                "phase_authorization", "--target-type", "phase-gate", "--target-id", "SYNTHETIC-GATE",
                "--target-hash", "a" * 64, "--reason", "synthetic", "--scope", "synthetic exact scope",
                "--approval-id", self.approval_id, "--recover-output", "--out", str(temporary / "out.json"),
            ]

            def replace(candidate: dict) -> None:
                payload = json.dumps(candidate, sort_keys=True, separators=(",", ":"))
                with store._connection() as connection:
                    connection.execute("UPDATE artifacts SET payload_json = ? WHERE artifact_id = ?", (payload, self.approval_id))

            cases: list[tuple[str, dict, str]] = []
            tampered = dict(record)
            tampered["control_plane_seal"] = "0" * 64
            cases.append(("tampered", tampered, "approval_unsigned"))
            wrong_principal = dict(record)
            wrong_principal["approver_principal"] = "other-owner"
            cases.append(("principal", seal_approval(wrong_principal, SYNTHETIC_FIXTURE_KEY), "approval_principal_unknown"))
            wrong_method = dict(record)
            wrong_method["authentication_method"] = "local_authentication"
            cases.append(("method", seal_approval(wrong_method, SYNTHETIC_FIXTURE_KEY), "approval_weaker_method"))
            expired = dict(record)
            expired["expires_at"] = "2000-01-01T00:00:00Z"
            cases.append(("expired", seal_approval(expired, SYNTHETIC_FIXTURE_KEY), "approval_expired"))
            revoked = dict(record)
            revoked["revoked_at"] = "2000-01-01T00:00:00Z"
            cases.append(("revoked", seal_approval(revoked, SYNTHETIC_FIXTURE_KEY), "approval_revoked"))
            consumed = dict(record)
            consumed["consumed_at"] = "2000-01-01T00:00:00Z"
            cases.append(("consumed", seal_approval(consumed, SYNTHETIC_FIXTURE_KEY), "approval_consumed"))
            for label, candidate, expected in cases:
                replace(candidate)
                with self.subTest(label=label), self.assertRaises(ApprovalRejected) as raised:
                    with (
                        mock.patch.object(approve_command, "load_config", return_value=config),
                        mock.patch.object(approve_command, "EventStore", return_value=store),
                        mock.patch.object(approve_command, "ApprovalManager", return_value=manager),
                    ):
                        approve_command.run(argv)
                self.assertEqual(raised.exception.code, expected)
            replace(record)
            unknown = list(argv)
            unknown[unknown.index("--approval-id") + 1] = "33333333-3333-4333-8333-333333333333"
            with self.assertRaises(ApprovalRejected) as raised:
                with (
                    mock.patch.object(approve_command, "load_config", return_value=config),
                    mock.patch.object(approve_command, "EventStore", return_value=store),
                    mock.patch.object(approve_command, "ApprovalManager", return_value=manager),
                ):
                    approve_command.run(unknown)
            self.assertEqual(raised.exception.code, "approval_unsigned")
            self.assertEqual(store.event_count(), 1)


if __name__ == "__main__":
    unittest.main()
