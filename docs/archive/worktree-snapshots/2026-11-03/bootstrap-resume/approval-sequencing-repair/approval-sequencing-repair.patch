diff --git a/tools/agentctl/tests/test_approval_prebind.py b/tools/agentctl/tests/test_approval_prebind.py
new file mode 100644
--- /dev/null
+++ b/tools/agentctl/tests/test_approval_prebind.py
@@ -0,0 +1,130 @@
+"""Synthetic regression tests for prebound approval identities."""
+
+from __future__ import annotations
+
+import json
+import pathlib
+import subprocess
+import tempfile
+import unittest
+from datetime import datetime, timezone
+
+from agentctl.approval import (
+    SYNTHETIC_FIXTURE_KEY,
+    ApprovalManager,
+    ApprovalRejected,
+    build_approval,
+    seal_approval,
+)
+from agentctl.commands.approve import _assert_prebound_approval_id_unused
+from agentctl.scheduler import Scheduler, TaskSpec, task_approval_scope
+from agentctl.store import EventStore
+from agentctl.validate import _task_contract_hash
+
+
+def _repo_root() -> pathlib.Path:
+    return pathlib.Path(
+        subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip()
+    )
+
+
+class PreboundApprovalIdentityTests(unittest.TestCase):
+    root = _repo_root()
+    approval_id = "2f4dca7b-3e95-49eb-92c6-23b9691d0301"
+
+    def setUp(self) -> None:
+        self.temporary = tempfile.TemporaryDirectory()
+        self.database = pathlib.Path(self.temporary.name) / "runtime.sqlite3"
+        self.store = EventStore(self.database, repository_root=self.root)
+        self.policy = {"tiers": {"schema_commitment": ["local_authentication"]}}
+        self.approvals = ApprovalManager(
+            self.store, key=SYNTHETIC_FIXTURE_KEY, policy=self.policy
+        )
+
+    def tearDown(self) -> None:
+        self.temporary.cleanup()
+
+    def _spec_and_record(self, *, nonce: str = "a" * 32) -> tuple[TaskSpec, dict]:
+        contract = {
+            "artifact_type": "task-contract",
+            "identity": {"task_id": "P0-FWD-001", "contract_hash": ""},
+            "permissions": {"human_approval_ref": self.approval_id},
+        }
+        contract_hash = _task_contract_hash(contract)
+        contract["identity"]["contract_hash"] = contract_hash
+        base_commit = subprocess.check_output(
+            ["git", "rev-parse", "HEAD"], cwd=self.root, text=True
+        ).strip()
+        spec = TaskSpec(
+            task_id="P0-FWD-001",
+            work_package_id="P0-FWD",
+            contract_hash=contract_hash,
+            context_hash="c" * 64,
+            base_commit=base_commit,
+            capability_class="complex_implementation",
+            risk="high",
+            enforcement_class="sandboxed_tools",
+            writable_paths=("agent-system/work/P0/evidence/governance-capture.json",),
+            prohibited_paths=("docs/*",),
+            semantic_locks={},
+            maximum_attempts=1,
+            maximum_artifact_corrections=0,
+            human_approval_ref=self.approval_id,
+            human_approval_action="schema_commitment",
+        )
+        approval = build_approval(
+            principal="synthetic-principal",
+            machine_identity="synthetic-machine",
+            action="schema_commitment",
+            target_type="task-contract",
+            target_id=spec.task_id,
+            target_hash=contract_hash,
+            scope=task_approval_scope(spec),
+            reason="Synthetic exact prebound approval",
+            authentication_method="local_authentication",
+            approval_id=self.approval_id,
+            nonce=nonce,
+            now=datetime.now(timezone.utc),
+        )
+        return spec, seal_approval(approval, SYNTHETIC_FIXTURE_KEY)
+
+    def test_prebound_id_hashes_before_strong_synthetic_approval_and_dispatch(self) -> None:
+        _assert_prebound_approval_id_unused(self.database, self.approval_id)
+        spec, approval = self._spec_and_record()
+        self.assertEqual(approval["approval_id"], self.approval_id)
+        self.assertEqual(approval["target_hash"], spec.contract_hash)
+        self.assertEqual(approval["scope"], task_approval_scope(spec))
+        self.approvals.register(approval)
+        scheduler = Scheduler(self.store, approval_manager=self.approvals)
+        scheduler.register_task(spec)
+        scheduler.dispatch(spec.task_id, worker_identity="synthetic-worker")
+        stored = json.loads(
+            self.store.rows(
+                "SELECT payload_json FROM artifacts WHERE artifact_id = ?", (self.approval_id,)
+            )[0]["payload_json"]
+        )
+        self.assertIsNotNone(stored["consumed_at"])
+
+    def test_existing_id_is_rejected_before_authentication_and_cannot_be_reregistered(self) -> None:
+        spec, first = self._spec_and_record(nonce="a" * 32)
+        self.approvals.register(first)
+        original = self.store.rows(
+            "SELECT payload_json FROM artifacts WHERE artifact_id = ?", (self.approval_id,)
+        )[0]["payload_json"]
+        with self.assertRaises(ApprovalRejected) as raised:
+            _assert_prebound_approval_id_unused(self.database, self.approval_id)
+        self.assertEqual(raised.exception.code, "approval_id_collision")
+        _, second = self._spec_and_record(nonce="b" * 32)
+        with self.assertRaises(ApprovalRejected) as raised:
+            self.approvals.register(second)
+        self.assertEqual(raised.exception.code, "approval_id_collision")
+        self.assertEqual(
+            self.store.rows(
+                "SELECT payload_json FROM artifacts WHERE artifact_id = ?", (self.approval_id,)
+            )[0]["payload_json"],
+            original,
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
