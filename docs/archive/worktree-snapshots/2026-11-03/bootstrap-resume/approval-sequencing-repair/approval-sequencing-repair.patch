+def _validate_prebound_approval_id(value: str | None) -> str | None:
+    """Accept one canonical UUID as a future approval identity, not an approval."""
+    if value is None:
+        return None
+    try:
+        parsed = uuid.UUID(value)
+    except (AttributeError, ValueError) as exc:
+        raise ApprovalRejected(
+            "approval_input_invalid", "approval_id must be a canonical UUID"
+        ) from exc
+    if str(parsed) != value:
+        raise ApprovalRejected(
+            "approval_input_invalid", "approval_id must be a canonical UUID"
+        )
+    return value
+
+
+def _assert_prebound_approval_id_unused(database: Path, approval_id: str) -> None:
+    """Read the event store without initializing it; this never reserves an ID."""
+    if not database.exists():
+        return
+    try:
+        with sqlite3.connect(f"{database.resolve().as_uri()}?mode=ro", uri=True) as connection:
+            existing = connection.execute(
+                "SELECT 1 FROM artifacts WHERE artifact_id = ? LIMIT 1", (approval_id,)
+            ).fetchone()
+    except sqlite3.Error as exc:
+        raise ApprovalRejected(
+            "approval_state_unreadable", "approval state cannot be read before authentication"
+        ) from exc
+    if existing is not None:
+        raise ApprovalRejected(
+            "approval_id_collision", "approval identifier is already registered", approval_id=approval_id
+        )
+
+
+def _write_prebound_record(destination: Path, record: dict) -> None:
+    """Write the post-registration mirror without overwriting any existing file."""
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    try:
+        with destination.open("x", encoding="utf-8") as handle:
+            handle.write(json.dumps(record, sort_keys=True, indent=2) + "\n")
+    except FileExistsError as exc:
+        raise ApprovalRejected(
+            "approval_output_exists", "approval output already exists"
+        ) from exc
+
+
