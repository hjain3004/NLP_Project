    "external_side_effects": "REPLACE:false unless explicitly authorized",
    "enforcement_class": "REPLACE:proposal_only, sandboxed_tools, or unsandboxed_tools"
  },
  "verification": {
    "deterministic_checks": [
      "REPLACE:deterministic verification command"
    ],
    "behavioral_requirements": [
      "REPLACE:behavioral requirement"
    ],
    "protected_checks": [
      "REPLACE:protected check or remove this entry"
    ],
    "expected_artifacts": [
      "REPLACE:required output artifact"
    ],
    "definition_of_done": [
      "REPLACE:objective completion condition"
    ]
  },
  "budgets": {
    "maximum_attempts": "REPLACE:integer from 1 through 3",
    "maximum_repair_cycles": "REPLACE:integer 0 or 1",
    "maximum_artifact_corrections": "REPLACE:integer 0 or 1",
    "wall_clock_class": "REPLACE:wall-clock budget class",
    "token_class": "REPLACE:token budget class"
  },
  "escalation": {
    "local_repair_conditions": [
      "REPLACE:local repair condition"
    ],
    "capability_escalation_conditions": [
      "REPLACE:capability escalation condition"
    ],
    "replan_conditions": [
      "REPLACE:replanning condition"
    ],
    "architecture_escalation_conditions": [
      "REPLACE:architecture escalation condition"
    ],
    "human_approval_conditions": [
      "REPLACE:human approval condition"
    ]
  }
