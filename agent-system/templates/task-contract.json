{
  "artifact_type": "task-contract",
  "identity": {
    "task_id": "REPLACE:task identifier",
    "work_package_id": "REPLACE:work package identifier",
    "contract_version": "REPLACE:integer contract version",
    "contract_hash": "REPLACE:64-character canonical SHA-256",
    "base_commit": "REPLACE:40-character commit SHA or unbound while proposed",
    "execution_mode": "REPLACE:control_plane or bootstrap_retrospective",
    "status": "REPLACE:allowed status",
    "created_at": "REPLACE:RFC 3339 timestamp"
  },
  "intent": {
    "objective": "REPLACE:single task objective",
    "rationale": "REPLACE:why this task exists",
    "non_goals": [
      "REPLACE:explicit non-goal"
    ],
    "acceptance_behavior": [
      "REPLACE:observable accepted behavior"
    ]
  },
  "dependencies": {
    "requires": [
      "REPLACE:prerequisite task identifier or remove this entry"
    ],
    "consumes": [
      "REPLACE:interface:name@version or remove this entry"
    ],
    "produces": [
      "REPLACE:produced interface or artifact"
    ]
  },
  "scope": {
    "readable_paths": [
      "REPLACE:normalized relative readable path"
    ],
    "writable_paths": [
      "REPLACE:normalized relative writable path"
    ],
    "prohibited_paths": [
      "REPLACE:normalized relative prohibited path"
    ],
    "semantic_locks": [
      "REPLACE:semantic lock or remove this entry"
    ]
  },
  "routing": {
    "capability_class": "REPLACE:capability class",
    "complexity": "REPLACE:low, medium, or high",
    "risk": "REPLACE:low, medium, high, or critical",
    "minimum_reviewer_class": "REPLACE:minimum reviewer capability class"
  },
  "permissions": {
    "tool_allowlist": [
      "REPLACE:allowed tool"
    ],
    "command_allowlist": [
      "REPLACE:allowed command or command class"
    ],
    "network": "REPLACE:false unless explicitly authorized",
    "secret_access": "REPLACE:false",
    "may_modify_tests": "REPLACE:none, task_owned_only, or protected_with_approval",
