{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "implementation-manifest.schema.json",
  "title": "Implementation manifest",
  "description": "What a worker returns. Prose may summarize it; prose never replaces it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "task_id",
    "attempt_id",
    "lease_id",
    "lease_epoch",
    "fencing_token",
    "worker_role",
    "provider",
    "model",
    "model_version",
    "contract_hash",
    "context_hash",
    "base_commit",
    "result_commit",
    "files_changed",
    "commands_executed",
    "acceptance_criteria_addressed",
    "assumptions",
    "decisions",
    "deviations",
    "discovered_dependencies",
    "unresolved_risks",
    "usage",
    "termination_reason"
  ],
  "properties": {
    "artifact_type": {
      "const": "implementation-manifest",
      "description": "Discriminator. agentctl selects the schema from this value."
    },
    "task_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "lease_epoch": {
      "type": "integer"
    },
    "fencing_token": {
      "type": "string"
    },
    "worker_role": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "contract_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "result_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/*-]*$",
            "description": "Normalized relative POSIX path or glob. No leading '/', no '..', no bare '**'."
          },
          "change_type": {
            "type": "string",
            "enum": [
              "added",
              "modified",
              "deleted",
              "renamed"
            ]
          }
        },
        "required": [
          "path",
          "change_type"
        ]
      }
    },
    "commands_executed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "duration_ms": {
            "type": "integer"
          },
          "log_ref": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "exit_code",
          "duration_ms"
        ]
      }
    },
    "acceptance_criteria_addressed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "discovered_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "latency_ms": {
          "type": "integer"
        },
        "cost_usd": {
          "type": "number"
        }
      },
      "required": [
        "cost_usd",
        "input_tokens",
        "latency_ms",
        "output_tokens"
      ]
    },
    "termination_reason": {
      "type": "string",
      "enum": [
        "completed",
        "budget_exhausted",
        "blocked",
        "escalated",
        "canceled",
        "error"
      ]
    }
  }
}
