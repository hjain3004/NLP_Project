{"$id":"implementation-manifest.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"What a worker returns. Prose may summarize it; prose never replaces it.","properties":{"acceptance_criteria_addressed":{"items":{"type":"string"},"type":"array"},"artifact_type":{"const":"implementation-manifest","description":"Discriminator. agentctl selects the schema from this value."},"assumptions":{"items":{"type":"string"},"type":"array"},"attempt_id":{"type":"string"},"base_commit":{"pattern":"^[0-9a-f]{40}$","type":"string"},"commands_executed":{"items":{"additionalProperties":false,"properties":{"command":{"type":"string"},"duration_ms":{"type":"integer"},"exit_code":{"type":"integer"},"log_ref":{"type":"string"}},"required":["command","exit_code","duration_ms","log_ref"],"type":"object"},"type":"array"},"context_hash":{"pattern":"^[0-9a-f]{64}$","type":"string"},"contract_hash":{"pattern":"^[0-9a-f]{64}$","type":"string"},"decisions":{"items":{"type":"string"},"type":"array"},"deviations":{"items":{"type":"string"},"type":"array"},"discovered_dependencies":{"items":{"type":"string"},"type":"array"},"fencing_token":{"type":"string"},"files_changed":{"items":{"additionalProperties":false,"properties":{"change_type":{"enum":["added","modified","deleted","renamed"],"type":"string"},"path":{"description":"Normalized relative POSIX path or glob. No leading '/', no '..', no bare '**'.","pattern":"^[A-Za-z0-9._][A-Za-z0-9._/*-]*$","type":"string"}},"required":["path","change_type"],"type":"object"},"type":"array"},"lease_epoch":{"type":"integer"},"lease_id":{"type":"string"},"model":{"type":"string"},"model_version":{"type":"string"},"provider":{"type":"string"},"result_commit":{"pattern":"^[0-9a-f]{40}$","type":"string"},"task_id":{"type":"string"},"termination_reason":{"enum":["completed","budget_exhausted","blocked","escalated","canceled","error"],"type":"string"},"unresolved_risks":{"items":{"type":"string"},"type":"