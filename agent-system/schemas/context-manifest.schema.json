{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-manifest.schema.json",
  "title": "Context manifest",
  "description": "The compiled input for one role and task, with a content hash. Ten ordered inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "context_hash",
    "task_id",
    "attempt_id",
    "compiled_at",
    "role",
    "inputs",
    "excluded_by_policy"
  ],
  "properties": {
    "artifact_type": {
      "const": "context-manifest",
      "description": "Discriminator. agentctl selects the schema from this value."
    },
    "context_hash": {
      "type": "string",
      "description": "sha256_of_json over this manifest with context_hash removed.",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "compiled_at": {
      "type": "string",
      "format": "date-time"
    },
    "role": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority_excerpt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/*-]*$",
              "description": "Normalized relative POSIX path or glob. No leading '/', no '..', no bare '**'."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer"
            }
          },
          "required": [
            "path",
            "sha256",
            "bytes"
          ]
        },
        "role_contract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/*-]*$",
              "description": "Normalized relative POSIX path or glob. No leading '/', no '..', no bare '**'."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer"
            }
          },
          "required": [
            "path",
            "sha256",
            "bytes"
          ]
        },
        "task_contract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/*-]*$",
              "description": "Normalized relative POSIX path or glob. No leading '/', no '..', no bare '**'."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer"
            }
          },
          "required": [
            "path",
            "sha256",
            "bytes"
          ]
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/*-]*$",
                "description": "Normalized relative POSIX path or glob. No leading '/', no '..', no bare '**'."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer"
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ]
          }
        },
        "consumed_interfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/*-]*$",
                "description": "Normalized relative POSIX path or glob. No leading '/', no '..', no bare '**'."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer"
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ]
          }
        },
        "dependency_manifests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/*-]*$",
                "description": "Normalized relative POSIX path or glob. No leading '/', no '..', no bare '**'."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer"
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ]
          }
        },
        "failure_lessons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/*-]*$",
                "description": "Normalized relative POSIX path or glob. No leading '/', no '..', no bare '**'."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer"
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ]
          }
        },
        "base_commit_summary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/*-]*$",
              "description": "Normalized relative POSIX path or glob. No leading '/', no '..', no bare '**'."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer"
            }
          },
          "required": [
            "path",
            "sha256",
            "bytes"
          ]
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/*-]*$",
              "description": "Normalized relative POSIX path or glob. No leading '/', no '..', no bare '**'."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer"
            }
          },
          "required": [
            "path",
            "sha256",
            "bytes"
          ]
        },
        "budgets_and_output_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/*-]*$",
              "description": "Normalized relative POSIX path or glob. No leading '/', no '..', no bare '**'."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer"
            }
          },
          "required": [
            "path",
            "sha256",
            "bytes"
          ]
        }
      },
      "required": [
        "authority_excerpt",
        "base_commit_summary",
        "budgets_and_output_schema",
        "consumed_interfaces",
        "decisions",
        "dependency_manifests",
        "failure_lessons",
        "permissions",
        "role_contract",
        "task_contract"
      ]
    },
    "excluded_by_policy": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "prd",
          "conversation_history",
          "research_documents",
          "other_worker_reasoning",
          "secrets",
          "customer_documents",
          "obsolete_plans",
          "raw_logs"
        ]
      },
      "minItems": 8,
      "description": "All eight classes are recorded on every compile."
    }
  }
}
