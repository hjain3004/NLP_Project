{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture-audit.schema.json",
  "title": "Architecture audit",
  "description": "G0-12 evidence. Identity-bound so independence is compared, not asserted: agentctl audit ingest rejects an auditor session recorded in CONSTRUCTION-LOG.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "audit_id",
    "gate_id",
    "pass_id",
    "auditor_role",
    "auditor_provider",
    "auditor_model",
    "auditor_session_id",
    "auditor_run_id",
    "audited_commit",
    "audited_tree_hash",
    "artifact_families",
    "decision_coverage",
    "findings",
    "verdict",
    "independence_attestation"
  ],
  "properties": {
    "artifact_type": {
      "const": "architecture-audit",
      "description": "Discriminator. agentctl selects the schema from this value."
    },
    "audit_id": {
      "type": "string"
    },
    "gate_id": {
      "type": "string"
    },
    "pass_id": {
      "type": "string",
      "description": "e.g. pass-1, or 'merge' for the reconciling pass."
    },
    "auditor_role": {
      "type": "string"
    },
    "auditor_provider": {
      "type": "string"
    },
    "auditor_model": {
      "type": "string"
    },
    "auditor_session_id": {
      "type": "string"
    },
    "auditor_run_id": {
      "type": "string"
    },
    "audited_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "audited_tree_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decision_id": {
            "type": "string"
          },
          "assessment": {
            "type": "string",
            "enum": [
              "implemented",
              "deviates",
              "deferred"
            ]
          },
          "evidence_ref": {
            "type": "string"
          }
        },
        "required": [
          "decision_id",
          "assessment",
          "evidence_ref"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "important",
              "minor",
              "nit"
            ]
          },
          "violated_criterion": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "reproducible_evidence": {
            "type": "string"
          },
          "observed_behavior": {
            "type": "string"
          },
          "required_behavior": {
            "type": "string"
          },
          "required_outcome": {
            "type": "string"
          },
          "reviewer_confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "finding_id",
          "severity",
          "violated_criterion",
          "reproducible_evidence",
          "observed_behavior",
          "required_behavior",
          "required_outcome",
          "blocking"
        ]
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "no_blocking_findings",
        "blocking_findings",
        "cannot_audit"
      ]
    },
    "independence_attestation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fresh_session": {
          "type": "boolean"
        },
        "authoring_sessions_known": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "distinct": {
          "type": "boolean"
        }
      },
      "required": [
        "fresh_session",
        "distinct"
      ]
    }
  }
}
