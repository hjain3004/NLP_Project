{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-verdict.schema.json",
  "title": "Review verdict",
  "description": "An independent reviewer's judgement, bound to the exact reviewed artefact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "review_id",
    "task_id",
    "attempt_id",
    "reviewer_role",
    "reviewer_provider",
    "reviewer_model",
    "reviewer_session_id",
    "reviewer_run_id",
    "lease_id",
    "lease_epoch",
    "fencing_token",
    "reviewed_result_commit",
    "tree_hash",
    "diff_hash",
    "declared_base_commit",
    "contract_hash",
    "context_hash",
    "verification_evidence_hash",
    "findings",
    "verdict",
    "independence_attestation"
  ],
  "properties": {
    "artifact_type": {
      "const": "review-verdict",
      "description": "Discriminator. agentctl selects the schema from this value."
    },
    "review_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "reviewer_role": {
      "type": "string"
    },
    "reviewer_provider": {
      "type": "string"
    },
    "reviewer_model": {
      "type": "string"
    },
    "reviewer_session_id": {
      "type": "string"
    },
    "reviewer_run_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "lease_epoch": {
      "type": "integer"
    },
    "fencing_token": {
      "type": "string"
    },
    "reviewed_result_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tree_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "diff_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "declared_base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "contract_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verification_evidence_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "important",
              "minor",
              "nit"
            ]
          },
          "violated_criterion": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "reproducible_evidence": {
            "type": "string"
          },
          "observed_behavior": {
            "type": "string"
          },
          "required_behavior": {
            "type": "string"
          },
          "required_outcome": {
            "type": "string"
          },
          "reviewer_confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "finding_id",
          "severity",
          "violated_criterion",
          "file",
          "location",
          "reproducible_evidence",
          "observed_behavior",
          "required_behavior",
          "required_outcome",
          "reviewer_confidence",
          "blocking"
        ]
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "no_blocking_findings",
        "blocking_findings",
        "cannot_review"
      ]
    },
    "independence_attestation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author_session_id": {
          "type": "string"
        },
        "author_run_id": {
          "type": "string"
        },
        "distinct": {
          "type": "boolean",
          "description": "Worker-supplied claim. agentctl compares identity and rejects a false claim."
        }
      },
      "required": [
        "author_session_id",
        "author_run_id",
        "distinct"
      ]
    }
  }
}
