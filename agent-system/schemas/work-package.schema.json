{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-package.schema.json",
  "title": "Work package",
  "description": "A cohesive subsystem or milestone slice, planned as a unit by the work_package_planning role.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "work_package_id",
    "schema_version",
    "phase_id",
    "title",
    "objective",
    "deliverables",
    "depends_on",
    "initial_capability_class",
    "owning_planner_role",
    "semantic_locks",
    "acceptance_summary",
    "status",
    "bootstrap_phase",
    "created_at",
    "plan_hash"
  ],
  "properties": {
    "artifact_type": {
      "const": "work-package",
      "description": "Discriminator. agentctl selects the schema from this value."
    },
    "work_package_id": {
      "type": "string",
      "description": "e.g. P0-C"
    },
    "schema_version": {
      "type": "integer"
    },
    "phase_id": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "initial_capability_class": {
      "type": "string",
      "enum": [
        "architectural_authority",
        "work_package_planning",
        "complex_implementation",
        "standard_implementation",
        "mechanical_execution"
      ]
    },
    "owning_planner_role": {
      "type": "string"
    },
    "semantic_locks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "validated",
        "authorized",
        "in_progress",
        "complete",
        "canceled",
        "unassigned"
      ]
    },
    "bootstrap_phase": {
      "type": "boolean",
      "description": "True for P0's own construction. agentctl debug treats these as non-blocking until G0."
    },
    "reason": {
      "type": "string",
      "description": "Required explanation when status is 'unassigned' or 'canceled'."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
