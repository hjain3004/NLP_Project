{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "integration-manifest.schema.json",
  "title": "Integration manifest",
  "description": "Records a fan-in. The two constants encode that any alteration to the reviewed patch invalidates the review \u2014 a manifest that cannot honestly set them cannot be written.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "integration_id",
    "task_id",
    "integrator_role",
    "integrator_session_id",
    "lease_id",
    "lease_epoch",
    "fencing_token",
    "candidate_result_commit",
    "reviewed_diff_hash",
    "review_id",
    "integration_base_commit",
    "integration_commit",
    "merge_strategy",
    "candidate_patch_unchanged",
    "dependency_interface_hashes",
    "affected_gates_rerun",
    "completed_at"
  ],
  "properties": {
    "artifact_type": {
      "const": "integration-manifest",
      "description": "Discriminator. agentctl selects the schema from this value."
    },
    "integration_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "integrator_role": {
      "type": "string"
    },
    "integrator_session_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "lease_epoch": {
      "type": "integer"
    },
    "fencing_token": {
      "type": "string"
    },
    "candidate_result_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reviewed_diff_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_id": {
      "type": "string"
    },
    "integration_base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "integration_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "merge_strategy": {
      "const": "conflict_free_preserving_candidate"
    },
    "candidate_patch_unchanged": {
      "const": true
    },
    "dependency_interface_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "interface": {
            "type": "string"
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "interface",
          "hash"
        ]
      }
    },
    "affected_gates_rerun": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gate": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          }
        },
        "required": [
          "gate",
          "result"
        ]
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
