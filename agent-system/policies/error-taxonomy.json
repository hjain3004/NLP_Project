{
  "policy_id": "error-taxonomy-v1",
  "version": 1,
  "source": "docs/superpowers/specs/2026-08-31-cashbooks-multi-model-agent-system-design.md \u00a752",
  "infrastructure_retry_rule": "An infrastructure retry does not count as an implementation repair when evidence proves the candidate was never evaluated.",
  "categories": [
    {
      "category": "planning_error",
      "meaning": "Invalid DAG, incomplete contract, missing gate",
      "default_response": "work_package_planning repair once, then escalate"
    },
    {
      "category": "contract_stale",
      "meaning": "Dependency, interface, or base changed",
      "default_response": "Recompile context and revalidate"
    },
    {
      "category": "implementation_failure",
      "meaning": "Valid task, incorrect code",
      "default_response": "One local repair, then a stronger worker"
    },
    {
      "category": "verification_failure",
      "meaning": "Candidate fails an objective gate",
      "default_response": "Return evidence to the repair ladder"
    },
    {
      "category": "oracle_conflict",
      "meaning": "Test conflicts with an accepted requirement",
      "default_response": "Separate protected-test review"
    },
    {
      "category": "permission_violation",
      "meaning": "Worker exceeded files, tools, or actions",
      "default_response": "Stop the attempt and run an independent audit"
    },
    {
      "category": "infrastructure_failure",
      "meaning": "Toolchain, provider, simulator, disk, or network issue",
      "default_response": "Retry only after environment evidence"
    },
    {
      "category": "invalid_artifact",
      "meaning": "Provider output fails schema, hash, or provenance validation",
      "default_response": "Reject without state advancement"
    },
    {
      "category": "integration_conflict",
      "meaning": "Candidate conflicts after fan-in",
      "default_response": "Mechanical resolve or replan"
    },
    {
      "category": "budget_exhausted",
      "meaning": "Cost, token, attempt, or time limit reached",
      "default_response": "Stop and escalate"
    },
    {
      "category": "no_progress",
      "meaning": "Repeated failure without a meaningful delta",
      "default_response": "Stop and escalate"
    },
    {
      "category": "human_gate",
      "meaning": "Required authority unavailable",
      "default_response": "Remain blocked without a workaround"
    }
  ]
}
