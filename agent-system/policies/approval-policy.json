{
  "policy_id": "approval-policy-v1",
  "version": 1,
  "source": "docs/superpowers/specs/2026-08-31-cashbooks-multi-model-agent-system-design.md \u00a79.1.1 as amended by ADR-0005",
  "fallback_to_weaker_method": false,
  "unimplemented_tier_behaviour": "hard refusal; never downgraded",
  "seal": {
    "algorithm": "HMAC-SHA256",
    "field": "control_plane_seal",
    "is_digital_signature": false,
    "adr": "ADR-0005",
    "covered": "canonical_json(approval minus control_plane_seal, consumed_at, revoked_at)"
  },
  "tiers": {
    "phase_authorization": "interactive_tty_with_key_unlock",
    "work_package_authorization": "interactive_tty_with_key_unlock",
    "scope_authorization": "interactive_tty_with_key_unlock",
    "invariant_change": [
      "keychain_backed",
      "local_authentication"
    ],
    "protected_test_change": [
      "keychain_backed",
      "local_authentication"
    ],
    "schema_commitment": [
      "keychain_backed",
      "local_authentication"
    ],
    "destructive_operation": [
      "keychain_backed",
      "local_authentication"
    ],
    "release_or_public_claim": [
      "keychain_backed",
      "local_authentication"
    ]
  },
  "key_requirements": [
    "outside the repository and every worktree",
    "mode 0600",
    "fingerprint recorded in approval-principals.json",
    "mtime predates the first agentctl commit"
  ],
  "approve_command": {
    "requires_tty": true,
    "requires_key_unlock_passphrase": true,
    "scriptable": false
  }
}
